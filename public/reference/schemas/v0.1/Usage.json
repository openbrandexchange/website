{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbrandexchange.com/schemas/v0.1/Usage.json",
  "type": "object",
  "title": "Usage",
  "description": "Body of POST /obx/v1/usage. Organisation-level only: never include personal data.",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "UsageEvent.json"
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9]+-[a-z0-9_-]+$": true
  }
}
