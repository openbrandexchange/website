{
  "name": "openbrandexchange-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "openbrandexchange.com: static site (Astro) for Open Brand Exchange",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:directory": "node tools/validate-directory.mjs public/directory.json",
    "check:links": "node tools/check-links.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:directory && npm run typecheck && npm run build && npm run check:links && npm test",
    "deploy": "sh scripts/deploy-cloudflare-pages.sh",
    "typecheck": "astro check",
    "build:brochures": "node scripts/build-brochures.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "sync:glossary": "node scripts/sync-glossary.mjs",
    "sync:spec": "node scripts/sync-spec.mjs",
    "sync:templates": "node scripts/sync-templates.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "node tools/lighthouse.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
