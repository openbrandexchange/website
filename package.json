{
  "name": "openbrandexchange-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "openbrandexchange.com: static site (Astro) for Open Brand Exchange",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:directory": "node tools/validate-directory.mjs public/directory.json",
    "check:links": "node tools/check-links.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:directory && npm run build && npm run check:links && npm test",
    "deploy": "sh scripts/deploy-cloudflare-pages.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
