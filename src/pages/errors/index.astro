---
import Reference from '../../layouts/Reference.astro';
import data from '../../data/errors.json';
import { specDoc } from '../../i18n';

// `code` spans of the spec's table cells, rendered as <code>.
const parts = (text: string) => text.split('`').map((s, i) => ({ s, code: i % 2 === 1 }));
---

<Reference title="Error codes" description="The problem types of the Open Brand Exchange APIs: every obx_error with its HTTP status and meaning, and the label completeness warnings." path="/errors/">
  <section class="hero">
    <div class="wrap">
      <h1>Error codes</h1>
      <p class="lead">
        Every Open Brand Exchange API answers errors as <code>application/problem+json</code> with a machine-readable
        <code>obx_error</code> and <code>type</code> = <code>https://openbrandexchange.com/errors/&lt;obx_error&gt;</code>, the
        pages below. Software must handle codes it does not know by their HTTP status.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="table-scroll">
        <table>
          <thead><tr><th scope="col">obx_error</th><th scope="col">HTTP</th><th scope="col">Meaning</th></tr></thead>
          <tbody>
            {
              data.errors.map((e) => (
                <tr id={e.code}>
                  <th scope="row"><a href={`/errors/${e.code}/`}><code>{e.code}</code></a></th>
                  <td>{e.status}</td>
                  <td>{parts(e.meaning).map((p) => (p.code ? <code>{p.s}</code> : p.s))}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="prose">
        Source: the error table of <a href={specDoc('docs/protocol.md')}>protocol.md</a>. The OpenAPI descriptions are in the
        <a href="/reference/">API reference</a>.
      </p>
    </div>
  </section>
  <section class="section" aria-labelledby="warnings">
    <div class="wrap">
      <h2 id="warnings">Label completeness warnings</h2>
      <p class="prose">
        Since version 0.2, imports and the Ingest API warn when a product misses what its label needs under EU law. The code
        is in <code>obx_error</code> of an import row with <code>severity: warning</code>, and in
        <code>warning_details</code> of an Ingest result. A warning never blocks a write or publishing. Software must ignore
        warning codes it does not know.
      </p>
      <div class="table-scroll">
        <table>
          <thead><tr><th scope="col">Code</th><th scope="col">When</th><th scope="col">Column</th></tr></thead>
          <tbody>
            {
              data.warnings.map((w) => (
                <tr id={w.code}>
                  <th scope="row"><a href={`/errors/${w.code}/`}><code>{w.code}</code></a></th>
                  <td>{parts(w.when).map((p) => (p.code ? <code>{p.s}</code> : p.s))}</td>
                  <td><code>{w.column}</code></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="prose">
        Source: rule 10 of <a href={specDoc('docs/import-format.md#label-completeness')}>import-format.md</a>.
      </p>
    </div>
  </section>
</Reference>
