---
import '../styles/global.css';
import { langs, nativeNames, url } from '../i18n';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Open Brand Exchange</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main id="main" class="wrap section">
      <h1>Page not found</h1>
      <p>This page does not exist (anymore). Choose a language to go to the home page.</p>
      <p lang="nl">Deze pagina bestaat niet (meer). Kies een taal om naar de homepage te gaan.</p>
      <ul class="lang-grid">
        {langs.map((l) => <li><a href={url(l, 'home')} hreflang={l} lang={l}>{nativeNames[l]}</a></li>)}
      </ul>
    </main>
  </body>
</html>
