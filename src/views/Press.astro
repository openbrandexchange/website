---
// Press kit: the project in one paragraph, the name, and the "Works with" / "OBX compatible" badges
// (public/badges/, generated by brand/src/badges.py). One badge for every implementer that passes
// the conformance suite; nobody gets a different one.
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import { format, messages, url, type Lang } from '../i18n';
import { HELLO_EMAIL, orgVars } from '../lib/org';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.press;
const families = [
  { title: c.worksWith, variants: [{ label: c.horizontal, file: 'obx-works-with' }, { label: c.stacked, file: 'obx-works-with-stacked' }] },
  {
    title: c.compatible,
    variants: [
      { label: c.horizontal, file: 'obx-compatible' },
      { label: c.stacked, file: 'obx-compatible-stacked' },
      { label: c.square, file: 'obx-compatible-square' },
    ],
  },
];
const themes = [
  { key: 'light', label: c.light },
  { key: 'dark', label: c.dark },
] as const;
const base = '/badges/';
---

<PageHero title={c.h1} lead={c.lead} dark={false} />

<section class="band">
  <div class="wrap">
    <DocSection id="about" title={c.aboutTitle}>
      <p>{format(c.aboutP, orgVars(lang))}</p>
    </DocSection>
    <DocSection id="name" title={c.nameTitle}>
      <p>{c.nameP} <a href={url(lang, 'governance', '#name')}>{t.nav.governance}</a></p>
    </DocSection>
    <DocSection id="badges" title={c.badgesTitle}>
      <p>{c.badgesP}</p>
      {
        families.map((fam) => (
          <>
            <h3>“{fam.title}”</h3>
            <ul class="badge-grid">
              {fam.variants.flatMap((v) =>
                themes.map((th) => (
                  <li class:list={['badge-item', `badge-${th.key}`]}>
                    <div class="badge-preview">
                      <img src={`${base}${v.file}-${th.key}.svg`} alt={fam.title} loading="lazy" />
                    </div>
                    <p class="badge-label">
                      {v.label} · {th.label}
                    </p>
                    <p class="badge-files small">
                      <a href={`${base}${v.file}-${th.key}.svg`} download>SVG</a>
                      {' · '}
                      <a href={`${base}${v.file}-${th.key}.png`} download>PNG</a>
                      {' · '}
                      <a href={`${base}${v.file}-${th.key}-2x.png`} download>PNG 2×</a>
                    </p>
                  </li>
                )),
              )}
            </ul>
          </>
        ))
      }
      <p class="muted small">{c.formatsNote}</p>
    </DocSection>
    <DocSection id="rules" title={c.rulesTitle}>
      <ol>{c.rules.map((r) => <li>{r}</li>)}</ol>
      <p>
        <a href={url(lang, 'developers', '#conformance')}>{c.suiteLink}</a> · <a href={url(lang, 'check')}>{c.checkLink}</a> · <a href={url(lang, 'partners')}>{c.partnersLink}</a>
      </p>
    </DocSection>
    <DocSection id="contact" title={c.contactTitle}>
      <p>{c.contactP} <a href={`mailto:${HELLO_EMAIL}`}>{HELLO_EMAIL}</a></p>
    </DocSection>
  </div>
</section>
