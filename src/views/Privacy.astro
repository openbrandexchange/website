---
import { messages, repo, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = messages[lang].privacy;
---

<section class="hero">
  <div class="wrap">
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </div>
</section>

<section class="section">
  <div class="wrap prose">
    {
      c.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </>
      ))
    }
    <p class="muted">{c.contact} <a href={repo('website', '/issues')}>openbrandexchange/website</a></p>
  </div>
</section>
