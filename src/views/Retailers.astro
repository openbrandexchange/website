---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import Screenshot from '../components/Screenshot.astro';
import Icon from '../components/Icon.astro';
import { format, messages, nativeNames, url, type Lang } from '../i18n';
import { retailerCurl } from '../data/snippets';
import { switchKit, switchKitPath } from '../lib/switch-kit';
import { countryName } from '../lib/names';
import { labelExample, labelJson } from '../data/label-example';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.retailers;
const lb = c.label;
// What EU law requires (spec protocol.md §5.9.7, "Legal basis"): the first three rows are law,
// care, origin and certifications are voluntary, the textiles DPP is still to come.
const law = lb.law;
const lawKind = ['mandatory', 'mandatory', 'mandatory', 'voluntary', 'voluntary', 'voluntary', 'coming'] as const;
const parts: Record<string, string> = { outer: lb.outer, lining: lb.lining };
// Spec 0.2: recycled content is a property of the fibre; the label text has its own wording for it.
const fibre = (f: { fiber: string; recycled?: boolean }) => (lb.fibres as Record<string, string>)[f.recycled ? `recycled_${f.fiber}` : f.fiber] ?? f.fiber;
const care = (code: string) => (lb.careText as Record<string, string>)[code] ?? code;
const kits: { lang: Lang; label: string }[] = [{ lang, label: nativeNames[lang] }];
if (lang !== 'en') kits.push({ lang: 'en', label: c.kitEnglish });
---

<PageHero eyebrow={t.nav.retailers} title={t.brochure.retailersH1} lead={c.lead}>
  <Fragment slot="actions">
    <a class="button primary lg" href={url(lang, 'directory')}>{c.findLink} <Icon name="arrow" class="arrow" /></a>
    <a class="button secondary lg" href="#api">{c.apiTitle}</a>
  </Fragment>
  <Screenshot slot="visual" name="portal-article" lang={lang} alt={t.site.shots.portalArticle} sizes="(min-width: 1024px) 820px, calc(100vw - 32px)" eager />
</PageHero>

<section class="band" aria-labelledby="portal">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t.portalWord}</p>
      <h2 id="portal">{c.portalTitle}</h2>
      <p class="lead">{format(c.portalP, { portal: t.portalWord })}</p>
    </header>
    <ul class="features three" data-reveal="2">
      {
        c.portal.map((p) => (
          <li>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </li>
        ))
      }
    </ul>
    <div class="wide-shot" data-reveal>
      <Screenshot name="portal-ean" lang={lang} alt={t.site.shots.portalEan} sizes="(min-width: 1304px) 1240px, calc(100vw - 32px)" />
    </div>
  </div>
</section>

<section class="band band-alt" aria-labelledby="label">
  <div class="wrap split">
    <div class="split-copy" data-reveal>
      <p class="eyebrow">{lb.eyebrow}</p>
      <h2 id="label">{lb.title}</h2>
      <p>{lb.p}</p>
      <ul class="checks">
        {lb.points.map((x) => <li>{x}</li>)}
      </ul>
    </div>
    <div class="split-visual" data-reveal="2">
      <figure class="care-label">
        <figcaption class="small muted">{lb.example}</figcaption>
        <div class="care-label-card">
          <p class="care-label-title"><strong>Kestrel Trail · {lb.product}</strong> <span class="muted">{labelExample.styleNumber} · {lb.colour}</span></p>
          <dl>
            <dt>{lb.composition}</dt>
            <dd>
              {labelExample.materials.map((m) => (
                <span class="care-line">{parts[m.part] ?? m.part}: {m.fibers.map((f) => `${f.percentage}% ${fibre(f)}`).join(', ')}</span>
              ))}
            </dd>
            <dt>{lb.care}</dt>
            <dd>
              <ol class="care-steps">
                {labelExample.care.map((code) => <li>{care(code)} <code>{code}</code></li>)}
              </ol>
            </dd>
            <dt>{lb.origin}</dt>
            <dd>{countryName(lang, labelExample.countryOfOrigin)}</dd>
            <dt>{lb.sizes}</dt>
            <dd>
              {labelExample.variants.map((v) => (
                <span class="care-line">{lb.size} {v.size}: <code>{v.gtin}</code></span>
              ))}
            </dd>
          </dl>
        </div>
      </figure>
      <Code label={lb.codeLabel} code={labelJson} />
    </div>
  </div>
  <div class="wrap law" data-reveal>
    <h3 id="law">{law.title}</h3>
    <p>{law.lead}</p>
    <div class="table-scroll">
      <table aria-labelledby="law">
        <thead><tr>{law.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          {
            law.rows.map((row, i) => (
              <tr class:list={[`law-${lawKind[i]}`]}>
                <th scope="row">{row.what}</th>
                <td>{lawKind[i] === 'mandatory' ? <strong>{row.status}</strong> : row.status}</td>
                {'basis' in row ? <td>{row.basis}</td> : <td class="law-none">—</td>}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="small muted">{law.note}</p>
  </div>
</section>

<section class="band band-ink" aria-labelledby="api">
  <div class="wrap split">
    <div class="split-copy" data-reveal>
      <p class="eyebrow">{t.site.pages.retailersSoftware}</p>
      <h2 id="api">{c.apiTitle}</h2>
      <p>{c.apiP}</p>
      <p class="muted">{c.apiDev}</p>
    </div>
    <div class="split-visual" data-reveal="2">
      <Code code={retailerCurl} />
    </div>
  </div>
</section>

<section class="band" aria-label={`${c.toolsTitle}, ${c.findTitle}`}>
  <div class="wrap">
    <ul class="features">
      <li>
        <h2 id="software" class="card-title">{c.toolsTitle}</h2>
        <p>{c.toolsP} <a href={url(lang, 'developers')}>{c.toolsLink}</a>.</p>
      </li>
      <li>
        <h2 id="find" class="card-title">{c.findTitle}</h2>
        <p>{c.findP} <a href={url(lang, 'directory')}>{c.findLink}</a>.</p>
      </li>
    </ul>
  </div>
</section>

<section class="band band-alt" aria-labelledby="switch-kit">
  <div class="wrap split">
    <div class="split-copy">
      <h2 id="switch-kit">{c.kitTitle}</h2>
      <p>{c.kitP}</p>
      <p class="muted">{c.kitMore} <a href={url(lang, 'downloads')}>{t.nav.downloads}</a>.</p>
    </div>
    <div class="split-visual">
      {
        kits.map((k) => {
          const kit = switchKit(k.lang);
          return (
            <div class="email-template" lang={k.lang}>
              <Code label={k.label} code={kit.text} />
              <p class="small">
                <a href={switchKitPath(k.lang)} download>
                  {c.kitDownload} ({k.label})
                </a>
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
