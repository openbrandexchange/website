---
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import { format, messages, specDoc, url, type Lang } from '../i18n';
import { orgVars } from '../lib/org';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = messages[lang].governance;
---

<PageHero eyebrow={messages[lang].site.home.trustEyebrow} title={c.h1} lead={c.lead} />

<section class="band">
  <div class="wrap">
    <DocSection id="foundation" title={c.foundationTitle}>
      <p>{format(c.foundationP, orgVars(lang))} <a href={url(lang, 'imprint')}>{messages[lang].nav.imprint}</a>.</p>
    </DocSection>
    {
      c.sections.map((s, i) => (
        <DocSection id={`section-${i + 1}`} title={s.h}>
          <p>{s.p}</p>
        </DocSection>
      ))
    }
    <DocSection id="name" title={c.nameTitle}>
      <div class="callout">
        <p>{c.nameP}</p>
      </div>
      <p><a href={specDoc('docs/governance.md')}>{c.specLink}</a></p>
    </DocSection>
  </div>
</section>
