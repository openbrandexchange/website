---
import { format, messages, specDoc, url, type Lang } from '../i18n';
import { orgVars } from '../lib/org';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = messages[lang].governance;
---

<section class="hero">
  <div class="wrap">
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </div>
</section>

<section class="section">
  <div class="wrap prose">
    <h2 id="foundation">{c.foundationTitle}</h2>
    <p>{format(c.foundationP, orgVars(lang))} <a href={url(lang, 'imprint')}>{messages[lang].nav.imprint}</a>.</p>
    {
      c.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </>
      ))
    }
    <h2 id="name">{c.nameTitle}</h2>
    <div class="callout">
      <p>{c.nameP}</p>
    </div>
    <p><a href={specDoc('docs/governance.md')}>{c.specLink}</a></p>
  </div>
</section>
