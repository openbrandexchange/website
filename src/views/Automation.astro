---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import CodeWindow from '../components/CodeWindow.astro';
import Icon from '../components/Icon.astro';
import { messages, repo, specDoc, url, type Lang } from '../i18n';
import * as s from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.automation;
const rowIds = ['scheduled', 'watch', 'cron', 'github', 'http', 'api'];
---

<PageHero eyebrow={t.nav.automation} title={t.site.home.pillars[2].h} lead={c.lead}>
  <Fragment slot="actions">
    <a class="button primary lg" href="#choose">{c.chooseTitle} <Icon name="arrow" class="arrow" /></a>
    <a class="button secondary lg" href={repo('obx-go', '/releases/latest')}>{c.cliGet}</a>
  </Fragment>
  <div slot="visual" class="stack">
    <CodeWindow code={s.pushTerminal} lang="shell" title="Terminal" />
    <CodeWindow code={s.pushAction} lang="yaml" title="publish.yml" label="GitHub Action" />
  </div>
</PageHero>

<section class="band" aria-labelledby="choose">
  <div class="wrap">
    <header class="section-head">
      <h2 id="choose">{c.chooseTitle}</h2>
    </header>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>{c.head.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {
            c.rows.map(([have, use, code], i) => (
              <tr>
                <td>{have}</td>
                <td>
                  <a href={`#${rowIds[i]}`}>{use}</a>
                </td>
                <td>{code}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="band band-alt">
  <div class="wrap">
    <DocSection id="format" title={c.formatTitle}>
      <p>{c.formatP}</p>
      <Code label={c.csvLabel} code={s.csvExample} />
      <Code label={c.namesLabel} code={s.fileNames} />
      <p><a href={specDoc('docs/import-format.md')}>{c.formatLink}</a></p>
    </DocSection>

    <DocSection id="key" title={c.keyTitle}>
      <p>{c.keyP}</p>
      <Code code={s.env} />
      <p class="muted">{c.keyTip}</p>
    </DocSection>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <DocSection id="scheduled" title={c.scheduledTitle}>
      <p>{c.scheduledP}</p>
      <ul>
        {
          c.scheduled.map((row) => (
            <li>
              <strong>{row.k}</strong>: {row.v}
            </li>
          ))
        }
      </ul>
      <p>{c.scheduledMode}</p>
    </DocSection>

    <DocSection id="cli" title={c.cliTitle}>
      <p>{c.cliP}</p>
      <Code code={s.cliBasics} />
      <p class="muted">{c.cliExit}</p>
      <p><a href={repo('obx-go', '/releases/latest')}>{c.cliGet}</a> · <a href={repo('obx-go')}>obx-go</a></p>
    </DocSection>

    <DocSection id="watch" title={c.watchTitle}>
      <p>{c.watchP}</p>
      <Code code={'obx watch /data/outbox'} />
      <Code label="Docker" code={s.watchDocker} />
    </DocSection>

    <DocSection id="cron" title={c.cronTitle}>
      <Code label={c.cronLinux} code={s.cron} />
      <Code label={c.cronWindows} code={s.windowsTask} />
    </DocSection>

    <DocSection id="github" title={c.githubTitle}>
      <p>{c.githubP}</p>
      <Code code={s.githubAction} />
    </DocSection>

    <DocSection id="http" title={c.httpTitle}>
      <p>{c.httpP}</p>
      <Code label={c.httpProduct} code={s.httpProduct} />
      <Code label={c.httpVariant} code={s.httpVariant} />
      <Code label={c.httpImage} code={s.httpImage} />
      <p class="muted">{c.httpImageNote}</p>
      <Code label={c.httpOffline} code={s.httpUnpublish} />
      <p>{c.httpHooks}</p>
    </DocSection>

    <DocSection id="api" title={c.apiTitle}>
      <p>{c.apiP}</p>
      <Code label={c.apiBatch} code={s.curlBatch} />
      <Code label={c.apiImport} code={s.curlImport} />
      <p>
        {c.apiMore}
        <a href={specDoc('openapi/obx-ingest.yaml')}>{c.apiSpec}</a> ·
        <a href={specDoc('docs/automation.md')}>{c.apiAuto}</a> ·
        <a href={repo('obx-go')}>{c.apiSdk}</a> ·
        <a href={url(lang, 'developers')}>{t.nav.developers}</a>
      </p>
    </DocSection>
  </div>
</section>
