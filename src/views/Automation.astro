---
import Code from '../components/Code.astro';
import { messages, repo, specDoc, url, type Lang } from '../i18n';
import * as s from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.automation;
const rowIds = ['scheduled', 'watch', 'cron', 'github', 'http', 'api'];
---

<section class="hero">
  <div class="wrap">
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </div>
</section>

<section class="section" aria-labelledby="choose">
  <div class="wrap">
    <h2 id="choose">{c.chooseTitle}</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>{c.head.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {
            c.rows.map(([have, use, code], i) => (
              <tr>
                <td>{have}</td>
                <td>
                  <a href={`#${rowIds[i]}`}>{use}</a>
                </td>
                <td>{code}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="format">{c.formatTitle}</h2>
    <p class="prose">{c.formatP}</p>
    <Code label={c.csvLabel} code={s.csvExample} />
    <Code label={c.namesLabel} code={s.fileNames} />
    <p><a href={specDoc('docs/import-format.md')}>{c.formatLink}</a></p>

    <h2 id="key">{c.keyTitle}</h2>
    <p class="prose">{c.keyP}</p>
    <Code code={s.env} />
    <p class="prose muted">{c.keyTip}</p>
  </div>
</section>

<section class="section">
  <div class="wrap prose">
    <h2 id="scheduled">{c.scheduledTitle}</h2>
    <p>{c.scheduledP}</p>
    <ul>
      {
        c.scheduled.map((row) => (
          <li>
            <strong>{row.k}</strong>: {row.v}
          </li>
        ))
      }
    </ul>
    <p>{c.scheduledMode}</p>

    <h2 id="cli">{c.cliTitle}</h2>
    <p>{c.cliP}</p>
    <Code code={s.cliBasics} />
    <p class="muted">{c.cliExit}</p>
    <p><a href={repo('obx-go', '/releases/latest')}>{c.cliGet}</a> · <a href={repo('obx-go')}>obx-go</a></p>

    <h2 id="watch">{c.watchTitle}</h2>
    <p>{c.watchP}</p>
    <Code code={'obx watch /data/outbox'} />
    <Code label="Docker" code={s.watchDocker} />

    <h2 id="cron">{c.cronTitle}</h2>
    <Code label={c.cronLinux} code={s.cron} />
    <Code label={c.cronWindows} code={s.windowsTask} />

    <h2 id="github">{c.githubTitle}</h2>
    <p>{c.githubP}</p>
    <Code code={s.githubAction} />

    <h2 id="http">{c.httpTitle}</h2>
    <p>{c.httpP}</p>
    <Code label={c.httpProduct} code={s.httpProduct} />
    <Code label={c.httpVariant} code={s.httpVariant} />
    <Code label={c.httpImage} code={s.httpImage} />
    <p class="muted">{c.httpImageNote}</p>
    <Code label={c.httpOffline} code={s.httpUnpublish} />
    <p>{c.httpHooks}</p>

    <h2 id="api">{c.apiTitle}</h2>
    <p>{c.apiP}</p>
    <Code label={c.apiBatch} code={s.curlBatch} />
    <Code label={c.apiImport} code={s.curlImport} />
    <p>
      {c.apiMore}
      <a href={specDoc('openapi/obx-ingest.yaml')}>{c.apiSpec}</a> ·
      <a href={specDoc('docs/automation.md')}>{c.apiAuto}</a> ·
      <a href={repo('obx-go')}>{c.apiSdk}</a> ·
      <a href={url(lang, 'developers')}>{t.nav.developers}</a>
    </p>
  </div>
</section>
