---
import PageHero from '../components/PageHero.astro';
import { format, messages, url, type Lang } from '../i18n';
import { HELLO_EMAIL, PRIVACY_UPDATED, longDate } from '../lib/org';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.cookies;
const contact = format(c.contact, { email: '\u0000' }).split('\u0000');
---

<PageHero title={c.h1} lead={c.lead} dark={false} />

<section class="band">
  <div class="wrap prose">
    {
      c.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </>
      ))
    }
    <p><a href={url(lang, 'privacy')}>{t.privacy.h1}</a></p>
    <p class="muted">
      {contact[0]}<a href={`mailto:${HELLO_EMAIL}`}>{HELLO_EMAIL}</a>{contact[1]}
    </p>
    <p class="muted small">{format(t.privacy.updated, { date: longDate(lang, PRIVACY_UPDATED) })}</p>
  </div>
</section>
