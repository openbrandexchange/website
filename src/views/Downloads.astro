---
import { messages, nativeNames, repo, url, type Lang } from '../i18n';
import { switchKitPath } from '../lib/switch-kit';
import { brochurePath, type BrochureKind } from '../lib/brochures';
import { langs } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.downloads;
const kitLangs: Lang[] = lang === 'en' ? ['en'] : [lang, 'en'];
const brochures: { kind: BrochureKind; title: string; p: string }[] = [
  { kind: 'brands', title: c.brandsTitle, p: c.brandsP },
  { kind: 'retailers', title: c.brochureTitle, p: c.brochureP },
];
---

<section class="hero">
  <div class="wrap">
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="cards">
      {
        brochures.map((b) => (
          <article class="card" aria-labelledby={`brochure-${b.kind}`}>
            <h2 id={`brochure-${b.kind}`} class="card-title">{b.title}</h2>
            <p>{b.p}</p>
            <ul class="plain">
              {kitLangs.map((l) => (
                <li>
                  <a href={brochurePath(b.kind, l)} hreflang={l} lang={l} type="application/pdf" download>
                    {nativeNames[l]} (PDF)
                  </a>
                </li>
              ))}
            </ul>
            <details class="more-langs">
              <summary>{c.allLanguages}</summary>
              <ul class="plain lang-grid">
                {langs.map((l) => (
                  <li>
                    <a href={brochurePath(b.kind, l)} hreflang={l} lang={l} type="application/pdf" download>
                      {nativeNames[l]}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </article>
        ))
      }
      <article class="card" aria-labelledby="kit">
        <h2 id="kit" class="card-title">{c.kitTitle}</h2>
        <p>{c.kitP} <a href={url(lang, 'retailers', '#switch-kit')}>{t.nav.retailers}</a></p>
        <ul class="plain">
          {kitLangs.map((l) => <li><a href={switchKitPath(l)} hreflang={l} download>{nativeNames[l]} (TXT)</a></li>)}
        </ul>
      </article>
      <article class="card" aria-labelledby="examples">
        <h2 id="examples" class="card-title">{c.exampleTitle}</h2>
        <p>{c.exampleP}</p>
        <p><a href={repo('spec', '/tree/main/fixtures/kestrel')}>{c.exampleLink}</a></p>
        <p class="small muted">{c.templateP}</p>
      </article>
    </div>
  </div>
</section>
