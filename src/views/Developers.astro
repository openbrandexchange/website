---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import CodeWindow from '../components/CodeWindow.astro';
import Icon from '../components/Icon.astro';
import { messages, repo, specDoc, url, type Lang } from '../i18n';
import { retailerCurl, conformance, discovery, discoveryResponse } from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.developers;

// `page` is the rendered reference of the spec, served at /reference/ (npm run sync:spec).
const apis = [
  { name: 'OBX Protocol', file: 'openapi/obx-protocol.yaml', page: '/reference/protocol.html' },
  { name: 'OBX Ingest API', file: 'openapi/obx-ingest.yaml', page: '/reference/ingest.html' },
  { name: 'Node Admin + Portal API', file: 'openapi/node-admin.yaml', page: '/reference/admin.html' },
];
const impl = [
  { repo: 'spec', licence: 'CC-BY-4.0', edition: '' },
  { repo: 'obx-go', licence: 'Apache-2.0', edition: '' },
  { repo: 'admin-ui', licence: 'Apache-2.0', edition: '' },
  { repo: 'node-go', licence: 'AGPL-3.0', edition: t.common.editionGoogle },
  { repo: 'node-php', licence: 'AGPL-3.0', edition: t.common.editionHosting },
  { repo: 'node-ts', licence: 'AGPL-3.0', edition: t.common.editionCloudflare },
];
const docs = [
  'docs/protocol.md',
  'docs/ingest.md',
  'docs/import-format.md',
  'docs/automation.md',
  'docs/security.md',
  'docs/versioning.md',
  'docs/directory.md',
];
---

<PageHero eyebrow={t.nav.developers} title={t.site.home.devTitle} lead={c.lead}>
  <Fragment slot="actions">
    <a class="button primary lg" href="/reference/">{t.site.footer.reference} <Icon name="arrow" class="arrow" /></a>
    <a class="button secondary lg" href={repo('spec')}>{t.site.footer.spec}</a>
  </Fragment>
  <div slot="visual" class="stack">
    <CodeWindow code={discovery} lang="shell" title="Terminal" />
    <CodeWindow code={discoveryResponse} lang="json" title="200 OK · application/json" />
  </div>
</PageHero>

<section class="band">
  <div class="wrap">
    <DocSection id="spec" title={c.specTitle}>
      <p>{c.specP}</p>
      <p><a href={repo('spec')}>openbrandexchange/spec</a> · <a href={specDoc('docs/protocol.md')}>{c.specStart}</a></p>
    </DocSection>

    <DocSection id="apis" title={c.apisTitle}>
      <div class="table-scroll">
        <table>
          <thead><tr>{c.apisHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {
              apis.map((api, i) => (
                <tr>
                  <th scope="row">{api.name}</th>
                  <td>{c.apis[i].who}</td>
                  <td>{c.apis[i].status}</td>
                  <td>
                    <a href={specDoc(api.file)}>
                      <code>{api.file.replace('openapi/', '')}</code>
                    </a>{' '}
                    · <a href={api.page}>HTML</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </DocSection>

    <DocSection id="read" title={c.readTitle}>
      <Code code={retailerCurl} />
    </DocSection>

    <DocSection id="sdk" title={c.sdkTitle}>
      <p>{c.sdkP}</p>
      <p><a href={repo('obx-go')}>obx-go</a> · <a href={url(lang, 'automation', '#cli')}>obx</a></p>
    </DocSection>

    <DocSection id="conformance" title={c.confTitle}>
      <p>{c.confP} <a href={specDoc('docs/conformance.md')}>conformance.md</a></p>
      <Code code={conformance} />
    </DocSection>
  </div>
</section>

<section class="band band-alt">
  <div class="wrap">
    <DocSection id="implementations" title={c.implTitle}>
      <div class="table-scroll">
        <table>
          <thead><tr>{c.implHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {
              impl.map((row, i) => (
                <tr>
                  <th scope="row">
                    <a href={repo(row.repo)}>{row.repo}</a>
                  </th>
                  <td>
                    {row.edition && <strong>{row.edition}</strong>}
                    {row.edition && <br />}
                    {c.impl[i]}
                  </td>
                  <td>{row.licence}</td>
                  <td>{c.statusDraft}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p>{c.implP}</p>
    </DocSection>

    <DocSection id="docs" title={c.docsTitle}>
      <ul class="link-list">
        {
          docs.map((file, i) => (
            <li>
              <a href={specDoc(file)}>
                <span>
                  <code>{file.replace('docs/', '')}</code> <span class="muted">{c.docs[i]}</span>
                </span>
                <Icon name="arrow" class="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
      <p>{c.contribute} <a href={url(lang, 'governance')}>{c.governanceLink}</a>.</p>
    </DocSection>
  </div>
</section>
