---
import Screenshot from '../components/Screenshot.astro';
import CodeWindow from '../components/CodeWindow.astro';
import Flow from '../components/Flow.astro';
import Editions from '../components/Editions.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { format, messages, repo, specDoc, url, type Lang } from '../i18n';
import Code from '../components/Code.astro';
import { prompts } from '../data/prompts';
import { orgVars, HELLO_EMAIL, SECURITY_EMAIL } from '../lib/org';
import { assetChange, pushAction, pushTerminal, DEMO_URL } from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const h = t.site.home;
const vars = { ...orgVars(lang), email: SECURITY_EMAIL, portal: t.portalWord };
const pillarLinks = [url(lang, 'retailers'), '/reference/', url(lang, 'automation')];
const devLinks = ['/reference/', repo('spec'), repo('obx-go'), '/errors/'];
const faq = t.faq.items.slice(0, 4);
// "Publish once. Every retailer gets it.": the second sentence in a softer tone, on its own line.
const split = h.h1.search(/[.!?]\s/);
const h1 = split > 0 ? [h.h1.slice(0, split + 1) + ' ', h.h1.slice(split + 2)] : [h.h1, ''];
const roleLinks = [url(lang, 'brands'), url(lang, 'retailers'), url(lang, 'developers')];
// The explainer video (public/video/, website/video/) is off the home page until a new version is
// ready; the three-block diagram takes its place in the hero.
---

<section class="band home-hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title">{h1[0]}{h1[1] && <span class="h1-soft">{h1[1]}</span>}</h1>
      <p class="lead">{h.lead}</p>
      <ul class="checks hero-checks">
        {h.heroChecks.map((item) => <li>{item}</li>)}
      </ul>
      <div class="actions">
        <a class="button primary lg" href={url(lang, 'brands')}>{t.site.nav.start} <Icon name="arrow" class="arrow" /></a>
        <a class="button secondary lg" href={url(lang, 'retailers')}>{h.ctaRetailer}</a>
      </div>
      <p class="hero-demo">
        <a href={DEMO_URL}>{t.demo.link} <Icon name="arrow" class="arrow" /></a>
        <span class="muted">{t.demo.linkNote}</span>
      </p>
      <p class="scope">
        <span class="sr-only">{h.scopeLabel}: </span><span class="scope-now">{h.scopeNow}</span>
        <span class="scope-next">{h.scopeNext}</span>
      </p>
      <dl class="proof" aria-label={h.proofLabel}>
        {
          h.proof.map((p) => (
            <div>
              <dt>{p.v}</dt>
              <dd>{p.l}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="hero-product hero-flow" data-reveal="2">
      <Flow lang={lang} stack />
    </div>
  </div>
</section>

<section class="band" aria-labelledby="flow-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{h.flowEyebrow}</p>
      <h2 id="flow-title">{h.flowTitle}</h2>
      <p class="lead">{h.flowLead}</p>
    </header>
  </div>
</section>

<section class="band band-alt" aria-label={h.pillars.map((p) => p.eyebrow).join(', ')}>
  <div class="wrap">
    {
      h.pillars.map((p, i) => (
        <article class:list={['split pillar', i === 1 && 'flip', 'wide']} aria-labelledby={`pillar-${i}`}>
          <div class="split-copy" data-reveal>
            <p class="eyebrow">
              <span class="pillar-index">0{i + 1}</span> {p.eyebrow}
            </p>
            <h2 id={`pillar-${i}`}>{p.h}</h2>
            <p>{p.p}</p>
            <ul class="checks">
              {p.items.map((item) => (
                <li>{format(item, vars)}</li>
              ))}
            </ul>
            <a class="link-arrow" href={pillarLinks[i]}>
              {p.link} <Icon name="arrow" class="arrow" />
            </a>
          </div>
          <div class="split-visual" data-reveal="2">
            {i === 0 && <Screenshot name="portal-ean" lang={lang} alt={t.site.shots.portalEan} sizes="(min-width: 1024px) 700px, calc(100vw - 32px)" />}
            {i === 1 && <CodeWindow code={assetChange} lang="json" title="GET /obx/v1/changes" label="Asset" />}
            {i === 2 && (
              <div class="stack">
                <CodeWindow code={pushTerminal} lang="shell" title="Terminal" />
                <CodeWindow code={pushAction} lang="yaml" title="publish.yml" label="GitHub Action" />
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="band" aria-labelledby="roles-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{h.rolesEyebrow}</p>
      <h2 id="roles-title">{h.rolesTitle}</h2>
      <p class="lead">{h.rolesLead}</p>
    </header>
    <div class="audience roles">
      {
        h.roles.map((a, i) => (
          <article class:list={['audience-card', i === 0 && 'dark']} aria-labelledby={`role-${i}`} data-reveal={String(i + 1)}>
            <h3 id={`role-${i}`}>{a.h}</h3>
            <p>{a.p}</p>
            <ul class="checks">
              {a.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="actions">
              <a class:list={['button', i === 0 ? 'primary' : 'secondary']} href={roleLinks[i]}>
                {a.cta} <Icon name="arrow" class="arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="band band-ink" aria-labelledby="fair-title">
  <div class="wrap split even top">
    <div class="split-copy">
      <p class="eyebrow">{h.fairEyebrow}</p>
      <h2 id="fair-title">{h.fairTitle}</h2>
      <p class="lead">{h.fairLead}</p>
    </div>
    <div class="split-visual">
      <ul class="checks">{h.fairItems.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</section>

<section class="band band-alt" aria-labelledby="portals-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{h.portalsEyebrow}</p>
      <h2 id="portals-title">{h.portalsTitle}</h2>
      <p class="lead">{h.portalsLead}</p>
    </header>
    <ul class="facts-grid portal-types" data-reveal="2">
      {
        h.portalTypes.map((item) => (
          <li>
            <h3>{item.h}</h3>
            <p>{item.p}</p>
          </li>
        ))
      }
    </ul>
    <p class="small muted portals-example">{h.portalsExample}</p>
    <p class="actions">
      <a class="button primary" href={url(lang, 'developers')}>{h.portalsCta} <Icon name="arrow" class="arrow" /></a>
    </p>
  </div>
</section>

<section class="band" aria-labelledby="editions-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{h.editionsEyebrow}</p>
      <h2 id="editions-title">{h.editionsTitle}</h2>
      <p class="lead">{h.editionsLead}</p>
      <p>{h.ownershipNote}</p>
    </header>
    <div data-reveal="2"><Editions lang={lang} /></div>
  </div>
</section>

<section class="band band-ink" aria-labelledby="trust-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{h.trustEyebrow}</p>
      <h2 id="trust-title">{h.trustTitle}</h2>
      <p class="lead">{h.trustLead}</p>
    </header>
    <ul class="facts-grid" data-reveal="2">
      {
        h.trust.map((item) => (
          <li>
            <h3>{item.h}</h3>
            <p>{format(item.p, vars)}</p>
          </li>
        ))
      }
    </ul>
    <p class="actions">
      <a class="link-arrow" href={url(lang, 'governance')}>{h.trustLink} <Icon name="arrow" class="arrow" /></a>
    </p>
  </div>
</section>

<section class="band" aria-labelledby="dev-title">
  <div class="wrap">
    <div class="split">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">{h.devEyebrow}</p>
        <h2 id="dev-title">{h.devTitle}</h2>
        <p>{h.devP}</p>
        <ul class="link-list">
          <li>
            <a href={specDoc('docs/quickstart.md')}>{h.devQuickstart} <Icon name="arrow" class="arrow" /></a>
          </li>
          {
            h.devLinks.map((label, i) => (
              <li>
                <a href={devLinks[i]}>
                  {label} <Icon name="arrow" class="arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="split-visual" data-reveal="2">
        <ul class="repo-list">
          {
            h.devRepos.map((r) => (
              <li>
                <a href={repo(r.name)}>
                  <span class="repo-name">openbrandexchange/{r.name}</span>
                  <span class="repo-d">{r.d}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="prompts" data-reveal="2">
      <h3 id="prompt-title">{h.promptTitle}</h3>
      <p>{h.promptP}</p>
      <div class="cards two">
        {
          h.prompts.map((pr, i) => (
            <div class="prompt">
              <Code code={prompts[i]} label={`${pr.h} · ${pr.note}`} lang="text" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="band band-alt" aria-labelledby="faq-title">
  <div class="wrap split">
    <header class="split-copy" data-reveal>
      <p class="eyebrow">{t.nav.faq}</p>
      <h2 id="faq-title">{h.faqTitle}</h2>
      <a class="link-arrow" href={url(lang, 'faq')}>{h.faqLink} <Icon name="arrow" class="arrow" /></a>
    </header>
    <div class="split-visual faq-list" data-reveal="2">
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{format(item.a, vars)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<CtaBand
  lang={lang}
  id="closing-title"
  title={h.closingTitle}
  text={h.closingP}
  primary={{ href: url(lang, 'brands'), label: t.site.nav.start }}
  secondary={{ href: `mailto:${HELLO_EMAIL}`, label: h.closingMail }}
/>
