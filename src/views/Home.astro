---
import { messages, url, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = messages[lang].home;
const stepPages: PageKey[] = ['hosting', 'automation', 'retailers'];
---

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <div class="actions">
      <a class="button primary" href={url(lang, 'brands')}>{c.ctaBrands}</a>
      <a class="button secondary" href={url(lang, 'retailers')}>{c.ctaRetailers}</a>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="how">
  <div class="wrap">
    <h2 id="how">{c.howTitle}</h2>
    <ol class="steps">
      {
        c.steps.map((s, i) => (
          <li>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
            <p>
              <a href={url(lang, stepPages[i])}>{s.link}</a>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="what">
  <div class="wrap">
    <h2 id="what">{c.whatTitle}</h2>
    <div class="cards">
      {
        c.what.map((w) => (
          <div class="card">
            <h3>{w.h}</h3>
            <p>{w.p}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section" aria-labelledby="why">
  <div class="wrap">
    <h2 id="why">{c.whyTitle}</h2>
    <div class="cards">
      {
        c.why.map((w) => (
          <div class="card">
            <h3>{w.h}</h3>
            <p>{w.p}</p>
          </div>
        ))
      }
    </div>
    <div class="callout">
      <p>{c.status} <a href={url(lang, 'governance')}>{c.statusLink}</a>.</p>
    </div>
  </div>
</section>
