---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import Editions from '../components/Editions.astro';
import Providers from '../components/Providers.astro';
import Icon from '../components/Icon.astro';
import { format, messages, url, type Lang } from '../i18n';
import * as s from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.hosting;
const domain = c.exampleDomain;
const withDomain = (text: string) => format(text, { domain });
// The click paths in c.dnsPaths follow this order.
const dnsProviders = ['TransIP', 'Hostnet', 'Strato', 'one.com', 'Cloudflare DNS', 'GoDaddy'];
---

<PageHero eyebrow={t.nav.hosting} title={c.heroTitle} lead={c.heroLead}>
  <Fragment slot="actions">
    <ul class="checks hero-checks">{c.heroChecks.map((item) => <li>{item}</li>)}</ul>
    <a class="button primary lg" href="#own-server">{c.installCta} <Icon name="arrow" class="arrow" /></a>
  </Fragment>
</PageHero>

<section class="band band-alt" aria-labelledby="editions-overview">
  <div class="wrap">
    <header class="section-head">
      <h2 id="editions-overview">{t.site.pages.hostingEditions}</h2>
      <p class="lead">{t.site.home.editionsLead}</p>
    </header>
    <Editions lang={lang} />
  </div>
</section>

<section class="band">
  <div class="wrap">
    <DocSection id="own-server" title={c.ownTitle}>
      <p>{c.ownP}</p>
      <h3>{c.needTitle}</h3>
      <ul>{c.needItems.map((item) => <li>{item}</li>)}</ul>
      <h3>{c.ownStepsTitle}</h3>
      <ol>{c.ownSteps.map((st) => <li>{withDomain(st)}</li>)}</ol>
      <Code code={s.linuxInstall(domain)} />
      <p class="small"><a href={s.NODE_RS_RELEASES}>{c.releaseLink}</a> · <a href="https://github.com/openbrandexchange/node-rs">openbrandexchange/node-rs</a></p>
      <p class="note">{c.ownEu}</p>
      <p class="actions">
        <a class="link-arrow" href="#technical">{c.techTitle} <Icon name="arrow" class="arrow" /></a>
      </p>
    </DocSection>

    <DocSection id="docker" title={c.dockerTitle}>
      <p>{c.dockerP}</p>
      <Code code={s.dockerInstall(domain)} />
      <p>{withDomain(c.dockerDone)}</p>
    </DocSection>

    <DocSection id="dns" title={c.dnsTitle}>
      <p>{c.dnsP}</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>{c.dnsHead.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            <tr>
              <td><code>A</code></td>
              <td><code>portal</code></td>
              <td>{c.dnsAValue}</td>
            </tr>
            <tr>
              <td>{c.dnsAaaaType}</td>
              <td><code>portal</code></td>
              <td>{c.dnsAaaaValue}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="small">{c.dnsNameNote}</p>
      <p>{c.dnsWhere}</p>
      <ul class="dns-paths">
        {
          dnsProviders.map((name, i) => (
            <li>
              <strong>{name}:</strong> {c.dnsPaths[i]}
            </li>
          ))
        }
      </ul>
      <h3>{c.dnsCheckTitle}</h3>
      <p>{c.dnsCheckP}</p>
      <Code code={s.digCheck(domain)} />
      <p>{c.dnsWait}</p>
    </DocSection>

    <details class="tech-details" id="technical">
      <summary><span id="technical-title">{c.techTitle}</span></summary>
      <p class="tech-lead">{c.techLead}</p>

      <DocSection id="operations" title={c.storageTitle}>
        <p>{c.storageP}</p>

        <h3>{c.commandsTitle}</h3>
        <Code code={s.serverCommands} />

        <h3>{c.httpsTitle}</h3>
        <p>{c.httpsP}</p>

        <h3>{c.backupTitle}</h3>
        <p>{c.backupP}</p>
        <p class="small"><a href={s.NODE_RS_BACKUP_DOC}>{c.backupLink} · docs/backup.md</a></p>

        <h3>{c.updateTitle}</h3>
        <p>{c.updateP}</p>
        <p class="small"><a href={s.NODE_RS_RELEASES}>{c.releaseLink}</a></p>
      </DocSection>

      <DocSection id="migrating" title={c.migrateTitle}>
        <p>{c.migrateP}</p>
        <p><a class="link-arrow" href={s.NODE_RS_MIGRATING_DOC}>{c.migrateLink} <Icon name="arrow" class="arrow" /></a></p>
      </DocSection>
    </details>
  </div>
</section>

<section class="band band-alt">
  <div class="wrap">
    <DocSection id="providers" title={c.p1Title}>
      <p>{c.p1P} <a href={url(lang, 'partners')}>{c.partnerLink}</a></p>
      <div class="cards"><Providers lang={lang} /></div>
    </DocSection>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <DocSection id="costs" title={c.costTitle}>
      <ul>{c.costItems.map((item) => <li>{item}</li>)}</ul>
      <p class="muted small">{c.costNote}</p>
    </DocSection>

    <DocSection id="first-start" title={c.firstTitle}>
      <ol>{c.first.map((f) => <li>{f}</li>)}</ol>
      <p class="muted">{c.firstWhy}</p>
    </DocSection>

    <DocSection id="domain" title={c.domainTitle}>
      <p>{c.domainP}</p>
    </DocSection>

    <DocSection id="editions" title={c.compareTitle}>
      <p>{c.compareP}</p>
      <p>{c.retireNote} <a href={s.NODE_RS_MIGRATING_DOC}>{c.migrateLink}</a></p>
    </DocSection>
  </div>
</section>
