---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import Editions from '../components/Editions.astro';
import Icon from '../components/Icon.astro';
import { messages, repo, url, type Lang } from '../i18n';
import * as s from '../data/snippets';
import Providers from '../components/Providers.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.hosting;
const env: [string, string][] = [
  ['OBX_PUBLIC_URL', c.envPublicUrl],
  ['OBX_SECRET_KEY', c.envSecretKey],
  ['OBX_SETUP_CODE', c.envSetupCode],
  ['PORT', c.envPort],
];
---

<PageHero eyebrow={t.nav.hosting} title={t.site.home.editionsTitle} lead={c.lead}>
  <Fragment slot="actions">
    <a class="button primary lg" href="#providers">{c.p1Title.replace(/^\d+\.\s*/, '')} <Icon name="arrow" class="arrow" /></a>
    <a class="button secondary lg" href="#one-click">{c.p2Title.replace(/^\d+\.\s*/, '')}</a>
  </Fragment>
</PageHero>

<section class="band band-alt" aria-labelledby="editions-overview">
  <div class="wrap">
    <header class="section-head">
      <h2 id="editions-overview">{t.site.pages.hostingEditions}</h2>
      <p class="lead">{t.site.home.editionsLead}</p>
    </header>
    <Editions lang={lang} />
  </div>
</section>

<section class="band" aria-labelledby="providers">
  <div class="wrap">
    <header class="section-head">
      <h2 id="providers">{c.p1Title}</h2>
      <p class="lead">{c.p1P}</p>
    </header>
    <div class="cards">
      <Providers lang={lang} />
      <article class="card accent" aria-labelledby="become-provider">
        <h3 id="become-provider">{c.listTitle}</h3>
        <p>{c.listP}</p>
        <ul>{c.listItems.map((i) => <li>{i}</li>)}</ul>
        <p class="small">
          {c.listHow} <a href={url(lang, 'partners')}>{t.partners.partnerCta}</a>
        </p>
      </article>
    </div>
  </div>
</section>

<section class="band band-alt" aria-labelledby="one-click">
  <div class="wrap">
    <header class="section-head">
      <h2 id="one-click">{c.p2Title}</h2>
      <p class="lead">{c.p2P}</p>
    </header>

    <DocSection id="cloudflare" title={t.common.editionCloudflare}>
      <p>{c.cfP}</p>
      <p>
        <a class="button primary" href="https://deploy.workers.cloudflare.com/?url=https://github.com/openbrandexchange/node-ts">{c.cfButton}</a>
      </p>
      <p class="small"><a href={repo('node-ts')}>openbrandexchange/node-ts</a></p>
    </DocSection>

    <DocSection id="cloud-run" title={t.common.editionGoogle}>
      <p>{c.runP}</p>
      <Code code={s.cloudRun} />
      <p class="small"><a href={repo('node-go')}>openbrandexchange/node-go</a> · <a href="#docker">Docker</a></p>
    </DocSection>

    <DocSection id="web-hosting" title={t.common.editionHosting}>
      <p>{c.phpP}</p>
      <ol>{c.phpSteps.map((st) => <li>{st}</li>)}</ol>
      <p class="small"><a href={repo('node-php', '/releases/latest')}>{c.phpDownload}</a> · <a href={repo('node-php')}>openbrandexchange/node-php</a></p>
    </DocSection>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <DocSection id="docker" title={c.p3Title}>
      <p>{c.p3P}</p>
      <Code code={s.dockerRun} />
      <p>{c.composeP}</p>
      <Code label="compose.yaml" code={s.dockerCompose} />
      <h3>{c.envTitle}</h3>
      <div class="table-scroll">
        <table>
          <tbody>
            {
              env.map(([k, v]) => (
                <tr>
                  <th scope="row">
                    <code>{k}</code>
                  </th>
                  <td>{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </DocSection>

    <DocSection id="first-start" title={c.firstTitle}>
      <ol>{c.first.map((f) => <li>{f}</li>)}</ol>
      <p class="muted">{c.firstWhy}</p>
    </DocSection>

    <DocSection id="domain" title={c.domainTitle}>
      <p>{c.domainP}</p>
    </DocSection>

    <DocSection id="editions" title={c.compareTitle}>
      <p>{c.compareP} <a href={url(lang, 'developers', '#implementations')}>{c.compareLink}</a>.</p>
    </DocSection>
  </div>
</section>
