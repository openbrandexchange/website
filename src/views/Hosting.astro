---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import Editions from '../components/Editions.astro';
import Providers from '../components/Providers.astro';
import Icon from '../components/Icon.astro';
import { messages, repo, url, type Lang } from '../i18n';
import * as s from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.hosting;
const env: [string, string][] = [
  ['OBX_PUBLIC_URL', c.envPublicUrl],
  ['OBX_SECRET_KEY', c.envSecretKey],
  ['OBX_SETUP_CODE', c.envSetupCode],
  ['PORT', c.envPort],
];
---

<PageHero eyebrow={t.nav.hosting} title={c.heroTitle} lead={c.heroLead}>
  <Fragment slot="actions">
    <ul class="checks hero-checks">{c.heroChecks.map((item) => <li>{item}</li>)}</ul>
    <a class="button primary lg" href="#europe">{c.euCta} <Icon name="arrow" class="arrow" /></a>
  </Fragment>
</PageHero>

<section class="band band-alt" aria-labelledby="editions-overview">
  <div class="wrap">
    <header class="section-head">
      <h2 id="editions-overview">{t.site.pages.hostingEditions}</h2>
      <p class="lead">{t.site.home.editionsLead}</p>
    </header>
    <Editions lang={lang} />
  </div>
</section>



<section class="band" aria-labelledby="europe">
  <div class="wrap">
    <header class="section-head">
      <h2 id="europe">{c.euTitle}</h2>
      <p class="lead">{c.euP}</p>
    </header>
    <ol class="steps steps-row steps-three">
      {c.euSteps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="note">{c.euData}</p>
    <p class="actions">
      <a class="link-arrow" href="#technical">{c.techTitle} <Icon name="arrow" class="arrow" /></a>
    </p>
  </div>
</section>

<section class="band band-alt">
  <div class="wrap">
    <DocSection id="web-hosting" title={c.webTitle}>
      <p>{c.webP}</p>
      <ol>{c.phpSteps.map((st) => <li>{st}</li>)}</ol>
      <p class="small"><a href={repo('node-php', '/releases/latest')}>{c.phpDownload}</a></p>
    </DocSection>
    <DocSection id="providers" title={c.p1Title}>
      <p>{c.p1P} <a href={url(lang, 'partners')}>{c.partnerLink}</a></p>
      <div class="cards"><Providers lang={lang} /></div>
    </DocSection>
  </div>
</section>

<section class="band" aria-labelledby="other-clouds">
  <div class="wrap">
    <header class="section-head">
      <h2 id="other-clouds">{c.altTitle}</h2>
      <p class="lead">{c.altP}</p>
    </header>
    <p><a class="link-arrow" href="#technical">{c.techTitle} <Icon name="arrow" class="arrow" /></a></p>
  </div>
</section>

<section class="band band-alt">
  <div class="wrap">
    <DocSection id="costs" title={c.costTitle}>
      <ul>{c.costItems.map((item) => <li>{item}</li>)}</ul>
      <p class="muted small">{c.costNote}</p>
    </DocSection>

    <DocSection id="first-start" title={c.firstTitle}>
      <ol>{c.first.map((f) => <li>{f}</li>)}</ol>
      <p class="muted">{c.firstWhy}</p>
    </DocSection>

    <DocSection id="domain" title={c.domainTitle}>
      <p>{c.domainP}</p>
    </DocSection>

    <DocSection id="editions" title={c.compareTitle}>
      <p>{c.compareP} <a href={url(lang, 'developers', '#implementations')}>{c.compareLink}</a>.</p>
    </DocSection>
  </div>
</section>

<section class="band" aria-labelledby="technical-title">
  <div class="wrap">
    <details class="tech-details" id="technical">
      <summary><span id="technical-title">{c.techTitle}</span></summary>
      <p class="tech-lead">{c.techLead}</p>

      <DocSection id="docker" title={c.euTitle.replace(/^\d+\.\s*/, '').replace(/\s*\(.*\)$/, '')}>
        <h3>{c.stepsTitle}</h3>
        <p>{c.stepsP}</p>
        <Code code={s.vpsSteps} />
        <p><a href={repo('node-go', '/blob/main/docs/hosting/hetzner.md')}>{c.euGuide}</a></p>

        <h3>{c.httpsTitle}</h3>
        <p>{c.httpsP}</p>

        <h3>{c.backupTitle}</h3>
        <p>{c.backupP}</p>
        <Code code={s.vpsBackup} />

        <h3>{c.updateTitle}</h3>
        <p>{c.updateP}</p>
        <Code code={s.vpsUpdate} />

        <h3>{c.envTitle}</h3>
        <div class="table-scroll">
          <table>
            <tbody>
              {
                env.map(([k, v]) => (
                  <tr>
                    <th scope="row">
                      <code>{k}</code>
                    </th>
                    <td>{v}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p>{c.p3P}</p>
        <Code code={s.dockerRun} />
        <p class="small"><a href={repo('node-go')}>openbrandexchange/node-go</a> · <a href={repo('node-php')}>openbrandexchange/node-php</a></p>
      </DocSection>

      <DocSection id="cloudflare" title={t.common.editionCloudflare}>
        <p>{c.cfP}</p>
        <p>
          <a class="button primary" href="https://deploy.workers.cloudflare.com/?url=https://github.com/openbrandexchange/node-ts">{c.cfButton}</a>
        </p>
        <p>{c.cfCliP}</p>
        <Code code={s.cfCli} />
        <p>{c.cfDomainP}</p>
        <p>{c.cfBackupP}</p>
        <p>{c.cfUpdateP}</p>
        <p class="small"><a href={repo('node-ts', '/blob/main/docs/hosting-cloudflare.md')}>openbrandexchange/node-ts · docs/hosting-cloudflare.md</a></p>
      </DocSection>

      <DocSection id="cloud-run" title={t.common.editionGoogle}>
        <p>{c.runP}</p>
        <Code code={s.cloudRun} />
        <p class="small"><a href={repo('node-go')}>openbrandexchange/node-go</a> · <a href="#docker">Docker</a></p>
      </DocSection>
    </details>
  </div>
</section>
