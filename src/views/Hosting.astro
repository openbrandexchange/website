---
import Code from '../components/Code.astro';
import PageHero from '../components/PageHero.astro';
import DocSection from '../components/DocSection.astro';
import Editions from '../components/Editions.astro';
import Providers from '../components/Providers.astro';
import Icon from '../components/Icon.astro';
import { messages, repo, url, type Lang } from '../i18n';
import * as s from '../data/snippets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const c = t.hosting;
const env: [string, string][] = [
  ['OBX_PUBLIC_URL', c.envPublicUrl],
  ['OBX_SECRET_KEY', c.envSecretKey],
  ['OBX_SETUP_CODE', c.envSetupCode],
  ['PORT', c.envPort],
];
---

<PageHero eyebrow={t.nav.hosting} title={c.heroTitle} lead={c.heroLead}>
  <Fragment slot="actions">
    <ul class="checks hero-checks">{c.heroChecks.map((item) => <li>{item}</li>)}</ul>
    <a class="button primary lg" href="#europe">{c.euCta} <Icon name="arrow" class="arrow" /></a>
  </Fragment>
</PageHero>

<section class="band band-alt" aria-labelledby="editions-overview">
  <div class="wrap">
    <header class="section-head">
      <h2 id="editions-overview">{t.site.pages.hostingEditions}</h2>
      <p class="lead">{t.site.home.editionsLead}</p>
    </header>
    <Editions lang={lang} />
  </div>
</section>



<section class="band" aria-labelledby="europe">
  <div class="wrap">
    <header class="section-head">
      <h2 id="europe">{c.euTitle}</h2>
      <p class="lead">{c.euP}</p>
    </header>
    <ol class="steps steps-row steps-three">
      {c.euSteps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="actions">
      <a class="button primary" href={repo('node-go', '/blob/main/docs/hosting/hetzner.md')}>{c.euGuide} <Icon name="arrow" class="arrow" /></a>
    </p>
    <p class="note">{c.euData}</p>
  </div>
</section>

<section class="band band-alt">
  <div class="wrap">
    <DocSection id="web-hosting" title={c.webTitle}>
      <p>{c.webP}</p>
      <ol>{c.phpSteps.map((st) => <li>{st}</li>)}</ol>
      <p class="small"><a href={repo('node-php', '/releases/latest')}>{c.phpDownload}</a> · <a href={repo('node-php')}>openbrandexchange/node-php</a></p>
    </DocSection>
    <DocSection id="providers" title={c.p1Title}>
      <p>{c.p1P} <a href={url(lang, 'partners')}>{c.partnerLink}</a></p>
      <div class="cards"><Providers lang={lang} /></div>
    </DocSection>
  </div>
</section>

<section class="band" aria-labelledby="other-clouds">
  <div class="wrap">
    <header class="section-head">
      <h2 id="other-clouds">{c.altTitle}</h2>
      <p class="lead">{c.altP}</p>
    </header>
    <DocSection id="cloudflare" title={t.common.editionCloudflare}>
      <p>{c.cfP}</p>
      <p>
        <a class="button primary" href="https://deploy.workers.cloudflare.com/?url=https://github.com/openbrandexchange/node-ts">{c.cfButton}</a>
      </p>
      <p class="small"><a href={repo('node-ts')}>openbrandexchange/node-ts</a></p>
    </DocSection>

    <DocSection id="cloud-run" title={t.common.editionGoogle}>
      <p>{c.runP}</p>
      <Code code={s.cloudRun} />
      <p class="small"><a href={repo('node-go')}>openbrandexchange/node-go</a> · <a href="#docker">Docker</a></p>
    </DocSection>

  </div>
</section>

<section class="band">
  <div class="wrap">
    <DocSection id="docker" title={c.p3Title.replace(/^\d+\.\s*/, '')}>
      <p>{c.p3P}</p>
      <Code code={s.dockerRun} />
      <p>{c.composeP}</p>
      <Code label="compose.yaml" code={s.dockerCompose} />
      <h3>{c.envTitle}</h3>
      <div class="table-scroll">
        <table>
          <tbody>
            {
              env.map(([k, v]) => (
                <tr>
                  <th scope="row">
                    <code>{k}</code>
                  </th>
                  <td>{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </DocSection>

    <DocSection id="first-start" title={c.firstTitle}>
      <ol>{c.first.map((f) => <li>{f}</li>)}</ol>
      <p class="muted">{c.firstWhy}</p>
    </DocSection>

    <DocSection id="domain" title={c.domainTitle}>
      <p>{c.domainP}</p>
    </DocSection>

    <DocSection id="editions" title={c.compareTitle}>
      <p>{c.compareP} <a href={url(lang, 'developers', '#implementations')}>{c.compareLink}</a>.</p>
    </DocSection>
  </div>
</section>
