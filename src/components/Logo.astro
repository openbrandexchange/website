---
// The mark: two offset bars that pass each other, one per side of the exchange.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg class="mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="#2450e8"></rect>
  <path d="M8 12.5h12.5" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
  <path d="m18.5 8.5 4 4-4 4" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M24 19.5H11.5" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".62"></path>
  <path d="m13.5 15.5-4 4 4 4" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity=".62"></path>
</svg>
