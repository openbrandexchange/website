---
// The mark: a woven garment label with "OBX", the notched ends cut like a folded label.
// The label takes the text colour; the letters punch through in the background colour.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
const width = Math.round((size * 44) / 26);
---

<svg class="mark" viewBox="0 0 44 26" width={width} height={size} aria-hidden="true" focusable="false">
  <path class="mark-label" d="M0 0h44l-4.5 13L44 26H0l4.5-13z"></path>
  <text class="mark-text" x="22" y="17.1" text-anchor="middle">OBX</text>
</svg>
