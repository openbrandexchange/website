---
// "Made in the EU · Built in the Netherlands": a geographic statement, with the EU flag small and
// unaltered (official colours, 12 stars). Never part of the OBX logo, never a quality seal, and
// never next to wording that suggests the European Union issues or endorses OBX.
import { messages, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang].common;
---

<p class="eu-badge">
  <svg class="eu-flag" viewBox="0 0 30 20" width="24" height="16" aria-hidden="true" focusable="false"><rect width="30" height="20" fill="#003399"/><g fill="#FFCC00"><polygon points="15.000,2.222 15.249,2.990 16.057,2.990 15.404,3.464 15.653,4.232 15.000,3.758 14.347,4.232 14.596,3.464 13.943,2.990 14.751,2.990"/><polygon points="18.333,3.115 18.583,3.883 19.390,3.883 18.737,4.358 18.986,5.125 18.333,4.651 17.680,5.125 17.930,4.358 17.277,3.883 18.084,3.883"/><polygon points="20.774,5.556 21.023,6.323 21.830,6.323 21.177,6.798 21.427,7.566 20.774,7.091 20.120,7.566 20.370,6.798 19.717,6.323 20.524,6.323"/><polygon points="21.667,8.889 21.916,9.657 22.723,9.657 22.070,10.131 22.320,10.899 21.667,10.424 21.014,10.899 21.263,10.131 20.610,9.657 21.417,9.657"/><polygon points="20.774,12.222 21.023,12.990 21.830,12.990 21.177,13.464 21.427,14.232 20.774,13.758 20.120,14.232 20.370,13.464 19.717,12.990 20.524,12.990"/><polygon points="18.333,14.662 18.583,15.430 19.390,15.430 18.737,15.905 18.986,16.672 18.333,16.198 17.680,16.672 17.930,15.905 17.277,15.430 18.084,15.430"/><polygon points="15.000,15.556 15.249,16.323 16.057,16.323 15.404,16.798 15.653,17.566 15.000,17.091 14.347,17.566 14.596,16.798 13.943,16.323 14.751,16.323"/><polygon points="11.667,14.662 11.916,15.430 12.723,15.430 12.070,15.905 12.320,16.672 11.667,16.198 11.014,16.672 11.263,15.905 10.610,15.430 11.417,15.430"/><polygon points="9.226,12.222 9.476,12.990 10.283,12.990 9.630,13.464 9.880,14.232 9.226,13.758 8.573,14.232 8.823,13.464 8.170,12.990 8.977,12.990"/><polygon points="8.333,8.889 8.583,9.657 9.390,9.657 8.737,10.131 8.986,10.899 8.333,10.424 7.680,10.899 7.930,10.131 7.277,9.657 8.084,9.657"/><polygon points="9.226,5.556 9.476,6.323 10.283,6.323 9.630,6.798 9.880,7.566 9.226,7.091 8.573,7.566 8.823,6.798 8.170,6.323 8.977,6.323"/><polygon points="11.667,3.115 11.916,3.883 12.723,3.883 12.070,4.358 12.320,5.125 11.667,4.651 11.014,5.125 11.263,4.358 10.610,3.883 11.417,3.883"/></g></svg>
