---
// The architecture at a glance: brand systems → automatic upload → the brand's portal →
// retailers in the browser and their software through the API. Real HTML lists (readable
// without the picture, and they wrap in every language); SVG only for the connectors.
import Icon from './Icon.astro';
import { messages, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = messages[lang].site.home;
const f = h.flow;
const systemIcons = ['database', 'layers', 'image', 'folder'] as const;
const uploadIcons = ['clock', 'terminal', 'branch', 'code'] as const;
const hubIcons = ['image', 'lock', 'chart'] as const;
---

<figure class="flow" aria-labelledby="flow-caption">
  <ol class="flow-cols">
    <li class="flow-col">
      <h3>{f.systems}</h3>
      <ul class="flow-list">
        {
          f.systemsItems.map((item, i) => (
            <li class="flow-node">
              <Icon name={systemIcons[i]} />
              {item}
            </li>
          ))
        }
      </ul>
      <svg class="flow-link" viewBox="0 0 48 2" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="1" x2="48" y2="1"></line></svg>
    </li>
    <li class="flow-col">
      <h3>{f.upload}</h3>
      <ul class="flow-list">
        {
          f.uploadItems.map((item, i) => (
            <li class="flow-node">
              <Icon name={uploadIcons[i]} />
              {item}
            </li>
          ))
        }
      </ul>
      <svg class="flow-link" viewBox="0 0 48 2" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="1" x2="48" y2="1"></line></svg>
    </li>
    <li class="flow-col">
      <div class="flow-hub">
        <h3>{f.portal}</h3>
        <span class="domain">{f.portalDomain}</span>
        <ul>
          {
            f.portalItems.map((item, i) => (
              <li>
                <Icon name={hubIcons[i]} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <svg class="flow-link" viewBox="0 0 48 2" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="1" x2="48" y2="1"></line></svg>
    </li>
    <li class="flow-col">
      <h3>{f.retailers}</h3>
      <div class="flow-group">
        <h4><Icon name="browser" />{f.browser}</h4>
        <ul>{f.browserItems.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="flow-group">
        <h4><Icon name="plug" />{f.software}</h4>
        <ul>{f.softwareItems.map((item) => <li>{item}</li>)}</ul>
      </div>
    </li>
  </ol>
  <figcaption id="flow-caption" class="sr-only">{h.flowCaption}</figcaption>
</figure>
