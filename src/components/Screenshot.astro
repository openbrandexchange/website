---
// A product screenshot (scripts/capture-screenshots.mjs) in a browser frame. Uses the page
// language when it was captured, else English. Astro turns the 2× WebP source into AVIF and WebP
// at several widths; the explicit width and height (CSS pixels) keep the layout stable while it loads.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';

interface Props {
  name: 'portal-catalog' | 'portal-ean' | 'portal-article' | 'admin-overview' | 'admin-catalog' | 'admin-stats' | 'admin-automation';
  lang: Lang;
  alt: string;
  /** The `sizes` attribute: how wide the frame is at each breakpoint. */
  sizes: string;
  /** Above the fold: load at once, with high priority. */
  eager?: boolean;
  url?: string;
  class?: string;
}

const { name, lang, alt, sizes, eager = false, url = 'brands.kestrel.example', class: extra } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*/*.webp', { eager: true });
const image = (files[`../assets/screens/${lang}/${name}.webp`] ?? files[`../assets/screens/en/${name}.webp`]).default;
const path = name.startsWith('admin') ? `${url}/admin` : url;
---

<figure class:list={['frame', extra]}>
  <div class="frame-bar" aria-hidden="true">
    <span class="frame-dots"><i></i><i></i><i></i></span>
    <span class="frame-url">{path}</span>
  </div>
  <Picture
    src={image}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960, 1280, 1920, 2560]}
    sizes={sizes}
    width={image.width / 2}
    height={image.height / 2}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
  />
</figure>
