---
// The four ways to run a portal, side by side with the same rows (subgrid).
import Icon from './Icon.astro';
import { messages, url, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = messages[lang];
const h = t.site.home;
// Europe first: an own server (node-go with Docker), ordinary web hosting (node-php), a partner,
// and the other clouds (node-ts on Cloudflare, node-go on Google Cloud Run).
const links = [url(lang, 'hosting', '#europe'), url(lang, 'hosting', '#web-hosting'), url(lang, 'hosting', '#providers'), url(lang, 'hosting', '#other-clouds')];
---

<ul class="editions">
  {
    h.editions.map((e, i) => (
      <li class:list={['edition', i === 0 && 'featured']}>
        <span class="edition-tag">{e.tag}</span>
        <h3>{e.name}</h3>
        <dl>
          {[e.runs, e.need, e.setup, e.cost].map((v, j) => (
            <div>
              <dt>{h.editionFields[j]}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        <a class="link-arrow" href={links[i]}>
          {e.cta} <Icon name="arrow" class="arrow" />
        </a>
      </li>
    ))
  }
</ul>
