---
// English-only pages for software and developers: /errors/, the problem types every portal
// answers with (`type` = https://openbrandexchange.com/errors/<obx_error>). Same look, header
// and footer as the site; the API reference itself is the spec's rendered site at /reference/.
import '../styles/global.css';
import { messages, url } from '../i18n';
import Logo from '../components/Logo.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const t = messages.en;
const site = Astro.site!.toString().replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="/js/early.js" is:inline></script>
    <title>{title} · Open Brand Exchange</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + path} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/js/site.js" defer is:inline></script>
  </head>
  <body data-copy={t.common.copy} data-copied={t.common.copied}>
    <a class="skip" href="#main">{t.common.skip}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="logo" href={url('en', 'home')} aria-label={t.common.home}>
          <Logo />
          <span>Open Brand Exchange</span>
        </a>
        <nav id="site-nav" class="site-nav" aria-label={t.common.mainMenu}>
          <ul>
            <li><a href={url('en', 'developers')}>{t.nav.developers}</a></li>
            <li><a href="/reference/">API reference</a></li>
            <li><a href="/errors/">Error codes</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang="en" />
  </body>
</html>
