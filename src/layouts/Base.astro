---
import '../styles/global.css';
import {
  langs,
  messages,
  nativeNames,
  ogLocales,
  url,
  xDefaultLang,
  type Lang,
  type PageKey,
} from '../i18n';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { format } from '../i18n';
import { HELLO_EMAIL, orgVars } from '../lib/org';
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter-tight/files/inter-tight-cyrillic-wght-normal.woff2?url';
import interGreek from '@fontsource-variable/inter-tight/files/inter-tight-greek-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const t = messages[lang];
// The check page keeps its strings (title and description too) in its own locale section.
const m = page === 'check' ? t.check.meta : t.meta[page];
const title = page === 'home' ? m.title : `${m.title} · Open Brand Exchange`;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = site + url(lang, page);

// Optional, cookieless Cloudflare Web Analytics. Off unless the token is set at build time.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const s = t.site;

// schema.org data, so search engines and AI assistants can describe and cite the project correctly.
const orgId = `${site}/#organization`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: 'Open Brand Exchange',
    alternateName: 'OBX',
    url: `${site}/`,
    logo: `${site}/favicon.svg`,
    email: HELLO_EMAIL,
    description: t.site.footer.tagline,
    sameAs: ['https://github.com/openbrandexchange'],
  },
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: `${site}/`,
    name: 'Open Brand Exchange',
    inLanguage: lang,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description: m.description,
    inLanguage: lang,
    isPartOf: { '@id': `${site}/#website` },
    about: { '@id': `${site}/#standard` },
  },
  {
    '@type': 'CreativeWork',
    '@id': `${site}/#standard`,
    name: 'Open Brand Exchange specification',
    alternateName: 'OBX',
    description: t.site.footer.tagline,
    version: '0.2',
    license: 'https://creativecommons.org/licenses/by/4.0/',
    url: 'https://github.com/openbrandexchange/spec',
    publisher: { '@id': orgId },
    keywords: 'product content, product images, article data, fibre composition, care label, open standard, API, retailers, brands',
  },
];
if (page === 'faq') {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: format(item.a, orgVars(lang)) },
    })),
  });
}
// Escape "<" so no text can close the script element.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const nav: PageKey[] = ['brands', 'retailers', 'hosting', 'developers'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="/js/early.js" is:inline></script>
    <title>{title}</title>
    <meta name="description" content={m.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={site + url(l, page)} />)}
    <link rel="alternate" hreflang="x-default" href={site + url(xDefaultLang, page)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Open Brand Exchange" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={m.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:image" content={`${site}/og/${lang}.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.home.h1} />
    <meta name="twitter:card" content="summary_large_image" />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'bg' && <link rel="preload" href={interCyrillic} as="font" type="font/woff2" crossorigin />}
    {lang === 'el' && <link rel="preload" href={interGreek} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script src="/js/site.js" defer is:inline></script>
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body data-copy={t.common.copy} data-copied={t.common.copied}>
    <a class="skip" href="#main">{t.common.skip}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="logo" href={url(lang, 'home')} aria-label={t.common.home}>
          <Logo size={30} />
        </a>
        <span class="pill" title={t.common.draft}><span class="pill-short" aria-hidden="true">v0.2</span><span class="pill-long">{s.nav.preview}</span><span class="sr-only">. {t.common.draft}</span></span>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>{t.common.menu}</button>
        <nav id="site-nav" class="site-nav" aria-label={t.common.mainMenu}>
          <ul>
            {
              nav.map((p) => (
                <li>
                  <a href={url(lang, p)} aria-current={p === page ? 'page' : undefined}>
                    {t.nav[p as keyof typeof t.nav]}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav-end">
            <details class="lang-switch">
              <summary>
                <Icon name="globe" />
                <span class="lang-code" aria-hidden="true">{lang.toUpperCase()}</span>
                <span class="sr-only">{nativeNames[lang]}, {t.common.languageLabel}</span>
              </summary>
              <ul class="lang-list" aria-label={t.common.languageLabel}>
                {
                  langs.map((l) => (
                    <li>
                      <a
                        href={url(l, page)}
                        hreflang={l}
                        lang={l}
                        data-lang-choice={l}
                        aria-current={l === lang ? 'true' : undefined}
                      >
                        {nativeNames[l]}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
            <a class="button primary" href={url(lang, 'brands')}>{s.nav.start}</a>
          </div>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
