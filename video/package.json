{
  "name": "obx-explainer-video",
  "private": true,
  "type": "module",
  "description": "The Open Brand Exchange explainer video (Remotion). Renders into ../public/video/.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice:en": "python3 scripts/voiceover.py src/copy/en.json public/voice/en --language en",
    "voice:nl": "python3 scripts/voiceover.py src/copy/nl.json public/voice/nl --language nl",
    "render": "node scripts/render.mjs en && node scripts/render.mjs nl && node scripts/render.mjs en --portrait && node scripts/render.mjs nl --portrait",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
